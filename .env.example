# ===== 服务端口 =====
GATEWAY_PORT=8080
DISPATCHER_PORT=8081

# ===== Redis =====
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== RabbitMQ =====
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ===== JWT =====
JWT_SECRET=please-change-me-in-production
JWT_EXPIRY_HOURS=24

# ===== LLM Provider（OpenAI 兼容格式，通义/豆包/DeepSeek 通用）=====
# DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com
# 通义:       OPENAI_BASE_URL=https://api.qwen.aliyun.com/compatible-mode/v1
# 豆包:       OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ===== 限流 =====
RATE_LIMIT_QPS=10
RATE_LIMIT_CAP=20

# ===== 缓存 =====
CACHE_TTL_SECONDS=3600
